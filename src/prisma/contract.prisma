// use prisma-8

enum Status {
  scheduled
  live
  finished
}

model Matches {
  id           Int          @id @default(autoincrement())
  sport        String
  homeTeam     String       @map("home_team")
  awayTeam     String       @map("away_team")
  status       Status       @default(scheduled)
  startTime    DateTime?    @map("start_time")
  endTime      DateTime?    @map("end_time")
  homeScore    Int          @default(0) @map("home_score")
  awayScore    Int          @default(0) @map("away_score")
  createdAt    DateTime     @default(now()) @map("created_at")

  commentaries Commentary[]

  @@map("matches")
}

model Commentary {
  id        Int      @id @default(autoincrement())
  matchId   Int      @map("match_id")

  match           Matches   @relation(fields: [matchId], references: [id])

  minute          Int?
  sequence        Int?
  period          String?
  eventType       String?   @map("event_type")
  actor           String?
  team            String?
  message         String
  metaData        Json?     @map("meta_data")
  tags            String[]
  createdAt       DateTime  @default(now()) @map("created_at")


  @@map("commentary")
}